# =============================================================================
# Portfolio Server Environment Configuration
# =============================================================================

# Server Port & Runtime Environment
PORT=3001
NODE_ENV=production

# SQLite Database & Upload Storage Paths
# Ensure these reside on a persistent disk or volume
DB_PATH=./portfolio.db
UPLOAD_DIR=./data/uploads

# Public Canonical Site URL (Used for sitemap, canonical links, og:image, and robots.txt)
# Leave unset or empty if not yet hosting on a custom domain (server omits wrong domain automatically)
# SITE_URL=https://example.com

# CORS & CSRF Allowed Origin (e.g. https://yourdomain.com)
# If unset, the server derives allowed origin from Host header (and X-Forwarded-Proto when TRUST_PROXY=true)
# ALLOWED_ORIGIN=https://example.com

# Reverse Proxy & Security Configuration
# Set TRUST_PROXY=true when operating behind a reverse proxy (e.g., Caddy, Nginx, Cloudflare)
TRUST_PROXY=true
TRUST_PROXY_HOPS=1

# Strict-Transport-Security (HSTS)
# Set FORCE_HTTPS=true in production to send HSTS header (max-age=15768000).
# Note: The HTTP-to-HTTPS redirect is performed by your reverse proxy (e.g. Caddy), not Node.
FORCE_HTTPS=true

# Content Security Policy (CSP) Mode
# Options: "report-only" (default, logs violations without blocking) or "enforce" (active blocking)
# Verify in browser console before switching to "enforce"
CSP_MODE=report-only

# In-Memory Rate Limiting (Requests per Window from server/api.js defaults)
RATE_LIMIT_PUBLIC=300
RATE_LIMIT_LOGIN=10
RATE_LIMIT_WRITE=60

# Media Upload Storage Constraints (from server/api.js defaults)
# Maximum uploads per IP per 24 hours (default: 50)
UPLOAD_DAILY_LIMIT=50
# Maximum aggregate storage size for uploads in bytes (default: 524288000 = 500 MB)
UPLOAD_MAX_STORAGE_BYTES=524288000

# Initial Admin Bootstrap Credentials (ONLY applied when DB is empty on first boot)
# For existing databases or post-deployment, reset credentials out-of-band via `node scripts/reset-admin.js`
ADMIN_USERNAME=admin
# ADMIN_INITIAL_PASSWORD=
