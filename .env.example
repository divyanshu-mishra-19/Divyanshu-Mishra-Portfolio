# =============================================================================
# Portfolio Server Environment Configuration
# =============================================================================

# Server Port & Runtime Environment
PORT=3001
NODE_ENV=production

# SQLite Database & Upload Storage Paths
# Ensure these reside on a persistent disk or volume
DB_PATH=./portfolio.db
UPLOAD_DIR=./data/uploads

# Public Canonical Site URL (Used for sitemap, canonical links, og:image, and robots.txt)
# Leave unset or empty if not yet hosting on a custom domain
SITE_URL=https://example.com

# CORS Configuration
# Set to your production frontend domain (e.g., https://example.com). If unset, same-origin only.
ALLOWED_ORIGIN=https://example.com

# Reverse Proxy & Security Configuration
# Set TRUST_PROXY=true when operating behind a reverse proxy (e.g., Caddy, Nginx, Cloudflare)
TRUST_PROXY=true
TRUST_PROXY_HOPS=1

# Strict HTTPS & Transport Security (HSTS)
# Set FORCE_HTTPS=true in production to enforce HTTPS redirects and HSTS headers
FORCE_HTTPS=true

# Content Security Policy (CSP) Mode
# Options: "report-only" (default, logs violations without blocking) or "enforce" (active blocking)
# Verify in browser console before switching to "enforce"
CSP_MODE=report-only

# In-Memory Rate Limiting (Requests per Window)
# Format: Max requests per IP within the sliding window
RATE_LIMIT_PUBLIC=300
RATE_LIMIT_LOGIN=5
RATE_LIMIT_WRITE=20

# Media Upload Storage Constraints
# Maximum uploads per IP per 24 hours (default: 20)
UPLOAD_DAILY_LIMIT=20
# Maximum aggregate storage size for uploads in bytes (default: 52428800 = 50 MB)
UPLOAD_MAX_STORAGE_BYTES=52428800

# Initial Admin Bootstrap Credentials (ONLY applied when DB is empty on first boot)
# For existing databases, use `node scripts/reset-admin.js` to set credentials
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=ChangeMeImmediatelyInProduction123!
